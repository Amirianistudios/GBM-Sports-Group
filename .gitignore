# Data working directory.
# Rule: RAW downloaded datasets stay out of Git (reproducibly re-downloadable).
# Generated/seed SQL and manifests ARE source and must be tracked.
data/*
!data/sql/
!data/manifests/
!data/fixtures/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
*.zip
tmp/

