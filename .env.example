# GBM Intelligence — environment template.
# Copy to .env.local (git-ignored) and fill in. Names, no values — the
# authoritative descriptions live in docs/DEPLOYMENT.md.

# --- Web application (also required by the ingestion service) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Ingestion only. Bypasses RLS: never expose via NEXT_PUBLIC_*. ---
# In GitHub Actions these arrive as repository secrets, not from this file.
SUPABASE_SERVICE_ROLE_KEY=
# Accepted alternative for projects issuing sb_secret_… keys:
# SUPABASE_SECRET_KEY=

# --- Developer tooling (optional) ---
# SUPABASE_ACCESS_TOKEN=          # pnpm db:types
# SUPABASE_PROJECT_REF=tyzndcjuiffnyhluddce
# API_FOOTBALL_KEY=               # season/match statistics probe
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# API_FOOTBALL_RATE_LIMIT_PER_SECOND=2
# REEP_API_KEY=                   # only for the metered Reep v1 API; the
# REEP_BASE_URL=                  # downloadable register needs no key
# GBM_USER_AGENT=
