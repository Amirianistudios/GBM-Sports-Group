{
  "name": "gbm-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Private football scouting and talent intelligence platform for GBM Sports Group.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gbm/web dev",
    "build": "pnpm --filter @gbm/web build",
    "start": "pnpm --filter @gbm/web start",
    "lint": "pnpm --filter @gbm/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "db:types": "tsx scripts/generate-types.ts",
    "data:download": "tsx services/ingestion/src/cli.ts download",
    "data:import": "tsx services/ingestion/src/cli.ts import",
    "data:update": "tsx services/ingestion/src/cli.ts update",
    "reep:resolve": "tsx services/ingestion/src/cli.ts resolve",
    "quality:check": "tsx services/ingestion/src/cli.ts quality",
    "signals:compute": "tsx services/ingestion/src/cli.ts signals",
    "intel:hourly": "tsx services/ingestion/src/cli.ts hourly",
    "ingest:status": "tsx services/ingestion/src/cli.ts status",
    "ingest:preflight": "tsx services/ingestion/src/cli.ts preflight",
    "ingest:verify": "tsx services/ingestion/src/cli.ts verify",
    "apifootball:test": "tsx scripts/test-apifootball.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0"
}
